# Conexión a PostgreSQL. Por defecto, el del Docker Compose (puerto 5433).
# Si usas un PostgreSQL instalado en tu máquina, cambia el puerto a 5432.
DATABASE_URL=postgresql://pagoseguro:pagoseguro@localhost:5433/pagoseguro

# AWS. En local va a LocalStack; en AWS, AWS_ENDPOINT_URL no se pone y las
# credenciales salen del rol. LocalStack acepta cualquier credencial.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=us-east-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Seed
SEED=42
SEED_MODE=dev
SEED_RESET=false
SEED_DEFECT_PERCENTAGE=0
SEED_CUENTAS_BLOQUEADAS_PCT=2
SEED_USUARIOS_EN_LISTA_PCT=0.1
SEED_USUARIOS_EN_LISTA_MIN=5
SEED_COMERCIOS_NUEVOS_PCT=10
SEED_COMERCIOS_NUEVOS_DIAS=30
# Volúmenes opcionales (si se omiten, se usan los del modo)
# SEED_USERS=100
# SEED_DEVICES_PER_USER=2
# SEED_MERCHANTS=50
# SEED_RESTRICTED_LISTS=20
# SEED_SHARED_DEVICES=4

# Lista del proveedor que exporta el seed para el servicio de listas
# (repo securepay-apis). file: solo generated/listas/. s3: además al bucket.
SEED_LIST_OUTPUT=file
# SEED_LIST_FILE=generated/listas/lista_restrictiva.jsonl
PROVEEDOR_LISTAS_BUCKET=pagoseguro-proveedor-listas
# PROVEEDOR_LISTAS_KEY=lista_restrictiva.jsonl

# ETL de los datasets históricos de Kaggle (opcionales; si se cambian, todos
# los compañeros deben usar los mismos valores)
# HIST_PAYSIM_FILAS=50000
# HIST_PAYSIM_FRAUDE_PCT=3
# HIST_FRAUDTEST_FILAS=20000
# HIST_FRAUDTEST_FRAUDE_PCT=3
# HIST_TAMANO_LOTE=5000
# Carpeta de los CSV. Si no se define, se busca en
# src/securepay_seed/kaggle_etl/raw, en KAGGLE_DOWNLOAD_DIR y en
# ../securepay-csv/data/kaggle (la descarga del repo securepay-csv).
# HIST_RAW_DIR=
# KAGGLE_DOWNLOAD_DIR=data/kaggle
